@@ -0,0 +1,28 @@
+import type { Container } from '../../platform/container.js';
+import { PullsRepository } from './repository.js';
+
+/**
+ * Sends a Slack notification when a PR review finishes, so a reviewer does
+ * not have to keep the pull requests list open to see when a run lands.
+ */
+export class PrNotifyService {
+  private repo: PullsRepository;
+
+  constructor(private container: Container) {
+    this.repo = new PullsRepository(container.db);
+  }
+
+  async notifyReviewComplete(prId: string, workspaceId: string): Promise<void> {
+    const pr = await this.repo.findById(prId, workspaceId);
+    if (!pr) return;
+
+    const webhookUrl = process.env.SLACK_WEBHOOK_URL;
+    if (!webhookUrl) return;
+
+    await fetch(webhookUrl, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ text: `Review finished for PR #${pr.number}: ${pr.title}` }),
+    });
+  }
+}
