+'use client';
+
+import { useEffect, useState } from 'react';
+import { usePulls } from '@/lib/hooks';
+
+interface LabelQuickFilterProps {
+  repoId: string;
+}
+
+/** Lets a reviewer narrow the pull list to PRs whose title mentions a label. */
+export function LabelQuickFilter({ repoId }: LabelQuickFilterProps) {
+  const { data: pulls } = usePulls(repoId);
+  const [cachedPulls, setCachedPulls] = useState(pulls);
+  const [selectedLabel, setSelectedLabel] = useState<string | null>(null);
+  const [availableLabels, setAvailableLabels] = useState<string[]>([]);
+
+  useEffect(() => {
+    setCachedPulls(pulls);
+  }, [pulls]);
+
+  useEffect(() => {
+    fetch(`/api/repos/${repoId}/labels`)
+      .then((res) => res.json())
+      .then((labels: string[]) => setAvailableLabels(labels));
+  }, [repoId]);
+
+  const visible = selectedLabel
+    ? (cachedPulls ?? []).filter((pr) => pr.title.includes(selectedLabel))
+    : (cachedPulls ?? []);
+
+  return (
+    <div>
+      <select value={selectedLabel ?? ''} onChange={(e) => setSelectedLabel(e.target.value || null)}>
+        <option value="">All labels</option>
+        {availableLabels.map((label) => (
+          <option key={label} value={label}>
+            {label}
+          </option>
+        ))}
+      </select>
+      <span>{visible.length} matching</span>
+    </div>
+  );
+}
