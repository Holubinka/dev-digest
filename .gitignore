node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# pr-self-review verdicts — local, per-branch, never shared. Load-bearing:
# report.sh records the worktree hash *inside* this directory, and scope.sh
# hashes every file it can see. If this stays visible to git, the recorded
# hash can never match the recomputed one (that would need a hash preimage),
# and gate.sh refuses every push forever with a stale-verdict message that
# points at an edit that does not exist. Includes baseline.json: it is
# per-checkout state, and a shared baseline would be a merge conflict on
# every branch. Do not remove this as clutter — see gate.sh's self-diagnosis
# for the failure this prevents.
.pr-self-review/

# Local screenshots. Nothing in the repo references them — the only mention is
# the rule in scripts/pr-self-review/scope.sh that skips them during review, so
# they are review-time noise with no consumer and 3.2 MB of binary weight.
.screenshots/

# Fix briefs written by /sdd between a review and the implementer that acts on
# it. Ignored for the same load-bearing reason as .pr-self-review/ above:
# scope.sh feeds worktreeHash from `git ls-files --others --exclude-standard`,
# which sees untracked files but not ignored ones. Un-ignore this and writing a
# brief after a passing --gates run silently invalidates that verdict, and the
# push is refused pointing at an edit nobody made. They are per-session working
# notes with no reader after the round they belong to.
.reviews/

# Run retrospectives: what a multi-agent run cost, written by the
# run-retrospective skill. Third instance of the same load-bearing reason as the
# two above — a report written here must not move worktreeHash. The durable half
# of a retrospective does not live here anyway: it goes to INSIGHTS.md, and what
# stays is the arithmetic for one run, which nobody reads twice.
.retro/
.claude/settings.local.json
